<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patchwork — Windows patch manager" Width="1280" Height="860"
        MinWidth="1060" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource UiBackground}" Foreground="{DynamicResource UiText}" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="UiBackground" Color="#0D121B"/>
    <SolidColorBrush x:Key="UiSidebar" Color="#121925"/>
    <SolidColorBrush x:Key="UiSurface" Color="#171F2D"/>
    <SolidColorBrush x:Key="UiSurfaceAlt" Color="#202A3A"/>
    <SolidColorBrush x:Key="UiInput" Color="#111925"/>
    <SolidColorBrush x:Key="UiBorder" Color="#354359"/>
    <SolidColorBrush x:Key="UiText" Color="#F1F5FB"/>
    <SolidColorBrush x:Key="UiMuted" Color="#B1BDCF"/>
    <SolidColorBrush x:Key="UiSubtle" Color="#A3AFC3"/>
    <SolidColorBrush x:Key="UiAccent" Color="#B5A1FF"/>
    <SolidColorBrush x:Key="UiAccentForeground" Color="#151222"/>
    <SolidColorBrush x:Key="UiAccentSoft" Color="#2B2540"/>
    <SolidColorBrush x:Key="UiAccentText" Color="#C9BAFF"/>
    <SolidColorBrush x:Key="UiHover" Color="#28344A"/>
    <SolidColorBrush x:Key="UiSelection" Color="#534579"/>
    <SolidColorBrush x:Key="UiSuccess" Color="#8ADDC0"/>
    <SolidColorBrush x:Key="UiSuccessSoft" Color="#17352D"/>
    <SolidColorBrush x:Key="UiWarning" Color="#F2CD89"/>
    <SolidColorBrush x:Key="UiWarningSoft" Color="#3C3020"/>
    <SolidColorBrush x:Key="UiError" Color="#FFC1B1"/>
    <SolidColorBrush x:Key="UiErrorSoft" Color="#452A29"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="Background" Value="{DynamicResource UiSurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource UiAccentText}"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.34"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource UiAccent}"/><Setter Property="Foreground" Value="{DynamicResource UiAccentForeground}"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="14,13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource UiAccentSoft}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource UiHover}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource UiInput}"/><Setter Property="Foreground" Value="{DynamicResource UiText}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource UiAccent}"/><Setter Property="SelectionBrush" Value="{DynamicResource UiSelection}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <Grid><ScrollViewer x:Name="PART_ContentHost" Margin="0"/><TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Foreground="{DynamicResource UiSubtle}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/></Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource UiAccentText}"/></Trigger><Trigger Property="Text" Value=""><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="Background" Value="{DynamicResource UiInput}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="Padding" Value="12,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="12,10,32,10" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,7,13,0" Foreground="{DynamicResource UiMuted}" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource UiAccentText}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="Padding" Value="10,9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource UiHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="CheckBorder" Width="22" Height="22" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1.5" CornerRadius="5" Background="{DynamicResource UiInput}">
            <Path x:Name="CheckMark" Data="M 4,10 L 8,14 L 16,5" Stroke="{DynamicResource UiAccentForeground}" StrokeThickness="2.5" Visibility="Collapsed" Margin="1"/>
          </Border>
          <ContentPresenter x:Name="CheckContent" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="HasContent" Value="False"><Setter TargetName="CheckContent" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource UiAccentText}"/><Setter TargetName="CheckBorder" Property="BorderThickness" Value="2.5"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource UiAccent}"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource UiAccentText}"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter TargetName="CheckBorder" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="Background" Value="{DynamicResource UiBackground}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" Width="8">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Background="{DynamicResource UiBorder}" CornerRadius="4" Margin="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource UiMuted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource UiSurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource UiText}"/><Setter Property="BorderBrush" Value="{DynamicResource UiBorder}"/><Setter Property="Padding" Value="9"/></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource UiBackground}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource UiSidebar}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,0,1,0">
      <Grid Margin="16,25,16,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="6,0,0,28">
            <Border Width="32" Height="32" Background="{DynamicResource UiAccent}" CornerRadius="9" Margin="0,0,10,0"><Grid><Rectangle Width="7" Height="19" Fill="{DynamicResource UiAccentForeground}" HorizontalAlignment="Left" Margin="8,0,0,0"/><Rectangle Width="11" Height="7" Fill="{DynamicResource UiAccentForeground}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,6,0,0"/><Rectangle Width="7" Height="7" Fill="{DynamicResource UiAccentForeground}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"/></Grid></Border>
            <TextBlock Text="patchwork" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Patches"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="26" FontSize="18"/><TextBlock Text="Patches" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Backups and restore"><StackPanel Orientation="Horizontal"><TextBlock Text="↶" Width="26" FontSize="20"/><TextBlock Text="Backups &amp; restore" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="SourcesNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Patch sources"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" Width="26" FontSize="20"/><TextBlock Text="Patch sources" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="AboutNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="26" FontSize="18"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border Background="{DynamicResource UiSurface}" CornerRadius="10" Padding="14" Margin="0,0,0,17"><StackPanel><TextBlock Text="Need a hand?" FontWeight="SemiBold"/><TextBlock Text="Read the setup steps, updates and restore guide." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="0,7,0,13" LineHeight="18"/><Button x:Name="PatchGuideButton" Content="Open user guide" FontSize="12" Padding="10,9"/></StackPanel></Border>
          <TextBlock x:Name="BuildVersion" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="8,0,0,0"/>
          <TextBlock Text="Changes stay on your PC" Foreground="{DynamicResource UiSubtle}" FontSize="11" Margin="8,7,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,26,28,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,18,0"><TextBlock x:Name="PageEyebrow" Text="PATCHWORK" Foreground="{DynamicResource UiAccentText}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="Choose what to change" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock x:Name="PageSubtitle" Text="Choose your app and patches, then review before applying." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" Margin="0,8,0,0" FontSize="13" LineHeight="19"/></StackPanel>
        <Button x:Name="ImportButton" Grid.Column="1" Content="＋  Open patch file" FontSize="12" VerticalAlignment="Top" Margin="0,6,0,0" ToolTip="Import a JSON or .patchwork pack you already downloaded"/>
      </Grid>
      <Grid Grid.Row="1" x:Name="LibraryPage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="AppHeader" CornerRadius="12" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="18" Margin="0,0,0,18">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="AppIconBorder" Background="{DynamicResource UiAccentSoft}" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"><TextBlock x:Name="AppIcon" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource UiAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="App &amp; patch pack" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="0,0,0,7"/><ComboBox x:Name="AppPicker" MaxWidth="350" HorizontalAlignment="Left" MinWidth="260" FontSize="14" AutomationProperties.Name="Choose an app and patch pack"/><TextBlock x:Name="AppMeta" FontSize="11" Foreground="{DynamicResource UiMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
            <Border x:Name="AppBadgeBorder" Grid.Column="2" Background="{DynamicResource UiSuccessSoft}" CornerRadius="6" Padding="10,7" VerticalAlignment="Center"><TextBlock x:Name="AppBadge" Foreground="{DynamicResource UiSuccess}" FontSize="11" FontWeight="SemiBold"/></Border>
          </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="LibraryContent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Choose your patches" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBox x:Name="SearchBox" Grid.Row="1" Tag="Search patches…" AutomationProperties.Name="Search patches" ToolTip="Search names, categories, or descriptions" Height="42" Margin="0,0,0,12"/>
            <Grid Grid.Row="2" Margin="0,0,0,12"><TextBlock x:Name="PatchCount" Foreground="{DynamicResource UiMuted}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="SelectAllButton" Content="Select all" FontSize="11" Padding="5,4" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource UiAccentText}" HorizontalAlignment="Right"/></Grid>
            <ScrollViewer Grid.Row="3" Padding="0,0,5,0"><StackPanel x:Name="PatchList"/></ScrollViewer>
          </Grid>
          <Border Grid.Column="2" Background="{DynamicResource UiSurface}" CornerRadius="12" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" Padding="18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer><StackPanel>

              <TextBlock x:Name="SessionTitle" Visibility="Collapsed" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,5"/>
              <TextBlock x:Name="SessionDescription" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource UiMuted}" LineHeight="17"/>
              <TextBlock Text="1. Choose the app folder" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock x:Name="FolderHint" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" FontSize="11" LineHeight="17" Margin="0,7,0,0"/>
              <TextBox x:Name="TargetBox" IsReadOnly="True" AutomationProperties.Name="Selected app folder" FontSize="11" Text="No folder selected" Margin="0,10,0,8"/>
              <Button x:Name="BrowseButton" Content="Choose folder…" Padding="12,9" FontSize="12"/>
              <TextBlock x:Name="TargetStatus" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" LineHeight="17"/>
              <Border BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,1,0,0" Margin="0,17,0,16"/>
              <TextBlock x:Name="SessionNote" Foreground="{DynamicResource UiWarning}" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,14,0,0"/>
            </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,15,0,0">              <Grid><TextBlock Text="2. Select patches" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="SelectedCount" HorizontalAlignment="Right" Foreground="{DynamicResource UiAccentText}" FontSize="12"/></Grid>
              <TextBlock x:Name="NextStepText" TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" FontSize="12" LineHeight="18" Margin="0,10,0,0"/>
              <Button x:Name="PreviewButton" Content="3. Review changes  →" Style="{StaticResource PrimaryButton}" Margin="0,17,0,10" Padding="12,13" IsEnabled="False" ToolTip="Build a preview without changing your app files"/>
              <TextBlock Text="Preview makes no changes. Apply creates a backup." Foreground="{DynamicResource UiMuted}" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
</StackPanel></Grid>
          </Border>
        </Grid>
        <Border x:Name="EmptyLibrary" Grid.RowSpan="2" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="14" Padding="32" Visibility="Collapsed">
          <ScrollViewer><StackPanel VerticalAlignment="Center" MaxWidth="650" Margin="0,18,0,18">
            <TextBlock Text="Start with a patch pack" FontSize="29" FontWeight="SemiBold"/>
            <TextBlock Text="A patch pack tells Patchwork what to change in an app. Get one from a source you trust, or open a file you already have." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="14" LineHeight="23" Margin="0,13,0,25"/>
            <Border Background="{DynamicResource UiAccentSoft}" CornerRadius="10" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Find patch packs" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Add a GitHub source to download packs and receive pack updates. The community repository is filled in for you." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,8,0,15"/><Button x:Name="EmptySourcesButton" Content="Find community patches  →" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="18,11"/></StackPanel></Border>
            <Border BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="Already have a patch file?" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Open a .json or .patchwork file you downloaded. It will appear in your library." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,8,0,15"/><Button x:Name="EmptyImportButton" Content="Open patch file…" HorizontalAlignment="Left" Padding="18,11"/></StackPanel></Border>
            <TextBlock Text="Next: choose the app folder and patches, review the changes, then apply. You can restore your original files from Backups &amp; restore." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="12" LineHeight="20" Margin="0,23,0,0"/>
          </StackPanel></ScrollViewer>
        </Border>
      </Grid>
      <Grid Grid.Row="1" x:Name="PreviewPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource UiSuccessSoft}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,0,15"><StackPanel><TextBlock Text="✓  Ready for your review" Foreground="{DynamicResource UiSuccess}" FontWeight="SemiBold"/><TextBlock x:Name="PreviewSummary" Foreground="{DynamicResource UiText}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="18"/></StackPanel></Border>
        <StackPanel Grid.Row="1" Margin="0,0,0,15"><TextBlock Text="File to review" Foreground="{DynamicResource UiMuted}" FontSize="11" Margin="0,0,0,7"/><ComboBox x:Name="PreviewFilePicker" AutomationProperties.Name="File to review"/></StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="10" Padding="15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="BeforeLabel" Text="Before" Foreground="{DynamicResource UiMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="BeforeText" Grid.Row="1" AutomationProperties.Name="File before changes" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent" Padding="0"/></Grid></Border>
          <Border Grid.Column="2" Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="10" Padding="15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="AfterLabel" Text="After applying" Foreground="{DynamicResource UiSuccess}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="AfterText" Grid.Row="1" AutomationProperties.Name="File after changes" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent" Padding="0"/></Grid></Border>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button x:Name="PreviewPreviousButton" Content="← Previous page" Padding="10,7" FontSize="12" Margin="0,0,12,0" IsEnabled="False"/><TextBlock x:Name="PreviewPageLabel" Text="Page 1 of 1" Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="PreviewNextButton" Content="Next page →" Padding="10,7" FontSize="12" IsEnabled="False"/></StackPanel>
        <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="BackButton" Content="← Back to selection"/><TextBlock Grid.Column="1" Text="Close the target app before applying.&#10;Original files are backed up automatically." TextWrapping="Wrap" Foreground="{DynamicResource UiMuted}" FontSize="11" VerticalAlignment="Center" Margin="18,0,18,0"/><Button x:Name="ApplyButton" Grid.Column="2" Content="Apply patches" Style="{StaticResource PrimaryButton}"/></Grid>
      </Grid>
      <Grid Grid.Row="1" x:Name="HistoryPage" Visibility="Collapsed"><ScrollViewer><StackPanel x:Name="HistoryList"/></ScrollViewer></Grid>
      <Grid Grid.Row="1" x:Name="SourcesPage" Visibility="Collapsed"><ScrollViewer><StackPanel>
        <Border Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,18"><StackPanel>
          <TextBlock Text="Add a patch source" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="A source is a GitHub repository that publishes patch packs. Add one you trust to download its packs into your library." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" LineHeight="21" FontSize="13" Margin="0,10,0,18"/>
          <TextBlock Text="Repository or release link" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="0,0,0,7"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SourceLinkBox" Tag="https://github.com/owner/patches" AutomationProperties.Name="GitHub patch source link" FontSize="13" Margin="0,0,12,0"/><Button x:Name="AddSourceButton" Grid.Column="1" Content="Add &amp; download packs" Style="{StaticResource PrimaryButton}"/></Grid>
          <CheckBox x:Name="SourcePrereleases" Content="Also include experimental patch packs" IsChecked="False" FontSize="12" Margin="0,16,0,15"/>
          <TextBlock Text="Sources update your library when Patchwork opens and about once an hour. To change an app, choose its patches, review the changes and apply them yourself." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="12" LineHeight="20"/>
        </StackPanel></Border>
        <WrapPanel Margin="0,0,0,14"><Button x:Name="CheckSourcesButton" Content="Check for pack updates" FontSize="12" Margin="0,0,15,6"/><TextBlock x:Name="SourcesStatus" Text="No GitHub sign-in needed" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"/></WrapPanel>
        <StackPanel x:Name="SourcesList"/>
      </StackPanel></ScrollViewer></Grid>
      <Grid Grid.Row="1" x:Name="AboutPage" Visibility="Collapsed"><ScrollViewer x:Name="AboutScroll"><StackPanel>
        <Border Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="12" Padding="23" Margin="0,0,0,17"><StackPanel>
          <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Choose a theme and accent. Changes apply immediately and are saved for next time." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="13" Margin="0,9,0,20" LineHeight="20"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Theme" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="0,0,0,7"/><ComboBox x:Name="ThemePicker" AutomationProperties.Name="App theme"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Accent color" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="0,0,0,7"/><ComboBox x:Name="AccentPicker" AutomationProperties.Name="Accent color"/></StackPanel></Grid>
          <TextBlock x:Name="AppearanceStatus" Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,14,0,0"/>
        </StackPanel></Border>
        <Border Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="12" Padding="23" Margin="0,0,0,17"><StackPanel>
          <TextBlock Text="Patchwork app updates" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="UpdateVersion" Foreground="{DynamicResource UiMuted}" FontSize="12" Margin="0,10,0,0"/>
          <TextBlock x:Name="UpdateStatus" Text="Check for a newer Patchwork version. Patch-pack updates are managed in Patch sources." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" LineHeight="20" FontSize="13" Margin="0,10,0,17"/>
          <CheckBox x:Name="AutoUpdateCheck" Content="Check when Patchwork opens" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,13"/>
          <CheckBox x:Name="AppPrereleases" Content="Include prerelease app versions (experimental)" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,18"/>
          <WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check for app updates" Margin="0,0,10,8"/><Button x:Name="InstallUpdateButton" Content="Download and install" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="0,0,10,8"/><Button x:Name="ReleasesButton" Content="View releases" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel></Border>
        <Border Background="{DynamicResource UiSurface}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="12" Padding="23"><StackPanel>
          <TextBlock Text="Your files &amp; backups" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Patchwork saves packs, preferences and verified backups in its data folder. Keep that folder so you can restore your apps. Updating Patchwork keeps it intact." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" LineHeight="21" FontSize="13" Margin="0,10,0,16"/>
          <WrapPanel><Button x:Name="OpenDataButton" Content="Open data folder" Margin="0,0,10,8"/><Button x:Name="OpenDocsButton" Content="Read user guide" Margin="0,0,10,8"/><Button x:Name="AuthorGuideButton" Content="Make your own packs" Margin="0,0,0,8"/></WrapPanel>
          <TextBlock Text="Windows 10/11 x64 · Local patching · No account needed&#10;Update checks connect to GitHub. Use patch packs from authors you trust." Foreground="{DynamicResource UiMuted}" TextWrapping="Wrap" FontSize="11" LineHeight="19" Margin="0,13,0,0"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource UiBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><StackPanel><ProgressBar x:Name="OperationProgress" Height="3" Width="180" HorizontalAlignment="Left" Margin="0,0,0,7" Foreground="{DynamicResource UiAccent}" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Preview first. Your app changes only when you apply." Foreground="{DynamicResource UiMuted}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
    </Grid>
  </Grid>
</Window>
