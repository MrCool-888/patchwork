<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patchwork — Windows patch manager" Width="1336" Height="890"
        MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="#0B1019" Foreground="#EBEFF7" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#929DB1"/>
    <SolidColorBrush x:Key="Accent" Color="#B4A1FF"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E5E9F3"/><Setter Property="Background" Value="#1B2332"/>
      <Setter Property="BorderBrush" Value="#2C3649"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.34"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#B4A1FF"/><Setter Property="Foreground" Value="#171125"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="14,13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#20283A"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101722"/><Setter Property="Foreground" Value="#E5E9F3"/>
      <Setter Property="CaretBrush" Value="#B4A1FF"/><Setter Property="SelectionBrush" Value="#564B83"/>
      <Setter Property="BorderBrush" Value="#283247"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <Grid><ScrollViewer x:Name="PART_ContentHost" Margin="0"/><TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Foreground="#66758E" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"/></Grid>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#B4A1FF"/></Trigger><Trigger Property="Text" Value=""><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E5E9F3"/><Setter Property="Background" Value="#161E2D"/>
      <Setter Property="BorderBrush" Value="#303A50"/><Setter Property="Padding" Value="12,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#161E2D" BorderBrush="#303A50" BorderThickness="1" CornerRadius="7"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="12,10,32,10" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,7,13,0" Foreground="#929DB1" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="#192131" BorderBrush="#3B4660" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="280"><ItemsPresenter/></ScrollViewer></Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E5E9F3"/><Setter Property="Padding" Value="10,9"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#313B53"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#A3AEC2"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="CheckBorder" Width="22" Height="22" BorderBrush="#46516B" BorderThickness="1.5" CornerRadius="5" Background="#101620">
            <Path x:Name="CheckMark" Data="M 4,10 L 8,14 L 16,5" Stroke="#171125" StrokeThickness="2.5" Visibility="Collapsed" Margin="1"/>
          </Border>
          <ContentPresenter x:Name="CheckContent" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="HasContent" Value="False"><Setter TargetName="CheckContent" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#B4A1FF"/><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#B4A1FF"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter TargetName="CheckBorder" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/><Setter Property="Background" Value="#111824"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}" Width="8">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBorder" Background="#364159" CornerRadius="4" Margin="1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#67738E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#243047"/><Setter Property="Foreground" Value="#EDF1FA"/><Setter Property="BorderBrush" Value="#43516B"/><Setter Property="Padding" Value="9"/></Style>
  </Window.Resources>
  <Grid Background="#0B1019">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#111722" BorderBrush="#202A3B" BorderThickness="0,0,1,0">
      <Grid Margin="18,25,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="7,0,0,29">
            <Border Width="34" Height="34" Background="#B4A1FF" CornerRadius="9" Margin="0,0,11,0"><Grid><Rectangle Width="7" Height="20" Fill="#161225" HorizontalAlignment="Left" Margin="8,0,0,0"/><Rectangle Width="11" Height="7" Fill="#161225" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,7,0,0"/><Rectangle Width="7" Height="7" Fill="#161225" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7"/></Grid></Border>
            <TextBlock Text="patchwork" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#65738C" Margin="13,0,0,9"/>
          <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Background="#272239" Foreground="#CCBEFF"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="27" FontSize="19"/><TextBlock Text="Patch library" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="HistoryNav" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="↶" Width="27" FontSize="20"/><TextBlock Text="History &amp; restore" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="SourcesNav" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" Width="27" FontSize="20"/><TextBlock Text="Patch sources" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="AboutNav" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" Width="27" FontSize="17"/><TextBlock Text="About this build" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#253044" BorderThickness="0,1,0,0" Margin="9,25,9,0" Padding="0,22,0,0">
          <StackPanel><TextBlock Text="LOCAL FIRST" FontSize="10" FontWeight="Bold" Foreground="#65738C"/><TextBlock Text="Your files stay on your PC." Foreground="#929DB1" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="Every change has a backup." Foreground="#929DB1" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <StackPanel Grid.Row="3">
          <Border Background="#182234" CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Bring your patch files" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Import separate files for the apps you want to change." TextWrapping="Wrap" Foreground="#929DB1" FontSize="12" Margin="0,7,0,13" LineHeight="18"/><Button x:Name="PatchGuideButton" Content="Patch-file guide  →" FontSize="12" Padding="10,9" Background="#252E43"/></StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="7,0"><Ellipse Width="6" Height="6" Fill="#85DCC0" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="v0.6.0  ·  Experimental" FontSize="11" Foreground="#73819A"/></StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,25,30,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24">
        <StackPanel><TextBlock x:Name="PageEyebrow" Text="WINDOWS APP PATCHER" Foreground="#A18BCF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="Make your apps yours." FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock x:Name="PageSubtitle" Text="Choose an app. Pick your patches. Stay in control." Foreground="#929DB1" Margin="0,8,0,0" FontSize="13"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,0,0"><Button x:Name="SourcesButton" Content="↻  Patch sources" FontSize="12" Margin="0,0,10,0"/><Button x:Name="ImportButton" Content="＋  Add patch file" FontSize="12"/></StackPanel>
      </Grid>
      <Grid Grid.Row="1" x:Name="LibraryPage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="AppHeader" CornerRadius="12" Background="#151D2B" BorderBrush="#2A354A" BorderThickness="1" Padding="18,16" Margin="0,0,0,22">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="AppIconBorder" Background="#36284E" Width="46" Height="46" CornerRadius="12" Margin="0,0,15,0"><TextBlock x:Name="AppIcon" Text="P" FontSize="25" FontWeight="Bold" Foreground="#C4AAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1"><ComboBox x:Name="AppPicker" Width="260" HorizontalAlignment="Left" FontSize="14"/><TextBlock x:Name="AppMeta" FontSize="11" Foreground="#929DB1" Margin="0,8,0,0"/></StackPanel>
            <Border x:Name="AppBadgeBorder" Grid.Column="2" Background="#322A1C" CornerRadius="5" Padding="11,6" VerticalAlignment="Center"><TextBlock x:Name="AppBadge" Text="BACKEND PLANNED" Foreground="#E9C985" FontSize="10" FontWeight="Bold"/></Border>
          </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="LibraryContent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="23"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" Tag="Search patches…" ToolTip="Search patch names, categories, or descriptions" Height="42" Margin="0,0,0,12"/>
            <Grid Grid.Row="1" Margin="0,0,0,12"><TextBlock x:Name="PatchCount" Text="AVAILABLE PATCHES" Foreground="#929DB1" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/><Button x:Name="SelectAllButton" Content="Select all ready" FontSize="11" Padding="0,4" Background="Transparent" BorderThickness="0" Foreground="#B4A1FF" HorizontalAlignment="Right"/></Grid>
            <ScrollViewer Grid.Row="2" Padding="0,0,5,0"><StackPanel x:Name="PatchList"/></ScrollViewer>
          </Grid>
          <Border Grid.Column="2" Background="#131B29" CornerRadius="12" BorderBrush="#253149" BorderThickness="1" Padding="20">
            <ScrollViewer><StackPanel>
              <TextBlock Text="YOUR PATCH SESSION" FontSize="10" FontWeight="Bold" Foreground="#73819A"/>
              <TextBlock x:Name="SessionTitle" FontSize="20" FontWeight="SemiBold" Margin="0,13,0,5"/>
              <TextBlock x:Name="SessionDescription" TextWrapping="Wrap" FontSize="12" Foreground="#929DB1" LineHeight="18"/>
              <Border BorderBrush="#2B3549" BorderThickness="0,1,0,0" Margin="0,19,0,17"/>
              <TextBlock Text="TARGET FOLDER" FontSize="10" FontWeight="Bold" Foreground="#73819A"/>
              <TextBox x:Name="TargetBox" IsReadOnly="True" FontSize="11" Text="No folder selected" Margin="0,9,0,8" ToolTip="Choose the app installation or configuration folder"/>
              <Button x:Name="BrowseButton" Content="Browse folder…" Padding="12,9" FontSize="12"/>
              <TextBlock x:Name="TargetStatus" Text="Select a folder to inspect the app." Foreground="#929DB1" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" LineHeight="17"/>
              <Border BorderBrush="#2B3549" BorderThickness="0,1,0,0" Margin="0,19,0,17"/>
              <Grid><TextBlock Text="Selected" Foreground="#929DB1" FontSize="12"/><TextBlock x:Name="SelectedCount" Text="0 patches" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/></Grid>
              <Grid Margin="0,10,0,0"><TextBlock Text="Backup" Foreground="#929DB1" FontSize="12"/><TextBlock Text="Automatic" Foreground="#85DCC0" HorizontalAlignment="Right" FontSize="12"/></Grid>
              <Button x:Name="PreviewButton" Content="Preview changes  →" Style="{StaticResource PrimaryButton}" Margin="0,22,0,12" Padding="12,13" IsEnabled="False"/>
              <TextBlock x:Name="SessionNote" Foreground="#929DB1" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
        <Border x:Name="EmptyLibrary" Grid.RowSpan="2" Background="#131B29" BorderBrush="#2B354A" BorderThickness="1" CornerRadius="14" Padding="38" Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470">
            <Border Background="#272239" Width="68" Height="68" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,23"><TextBlock Text="＋" Foreground="#B4A1FF" FontSize="34" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <TextBlock Text="Your library starts here." FontSize="27" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Text="Add a separate patch file or a GitHub patch source. Patchwork includes no patch packs." Foreground="#A3AEC2" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" LineHeight="23" Margin="0,16,0,27"/>
            <Button x:Name="EmptyImportButton" Content="＋  Add patch file" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="24,13"/>
            <Button x:Name="EmptySourcesButton" Content="Add a GitHub source" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="12"/>
            <TextBlock Text="JSON or .patchwork files · Preview before applying" Foreground="#73819A" TextAlignment="Center" FontSize="11" Margin="0,18,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="1" x:Name="PreviewPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#162B2A" BorderBrush="#2B4946" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="✓  File fingerprints verified" Foreground="#8DE2C5" FontWeight="SemiBold"/><TextBlock x:Name="PreviewSummary" Foreground="#A4C4B9" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <ComboBox x:Name="PreviewFilePicker" Grid.Row="1" Margin="0,0,0,16"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="#111925" BorderBrush="#2B364C" BorderThickness="1" CornerRadius="10" Padding="15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="BeforeLabel" Text="ORIGINAL" Foreground="#929DB1" FontSize="10" FontWeight="Bold" Margin="0,0,0,14"/><TextBox x:Name="BeforeText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent" Padding="0"/></Grid></Border>
          <Border Grid.Column="2" Background="#131E27" BorderBrush="#30423F" BorderThickness="1" CornerRadius="10" Padding="15"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PATCHED" Foreground="#8DE2C5" FontSize="10" FontWeight="Bold" Margin="0,0,0,14"/><TextBox x:Name="AfterText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="Transparent" Padding="0"/></Grid></Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,18,0,0"><Button x:Name="BackButton" Content="←  Back to patches" HorizontalAlignment="Left"/><Button x:Name="ApplyButton" Content="Back up &amp; apply patches" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/></Grid>
      </Grid>
      <Grid Grid.Row="1" x:Name="HistoryPage" Visibility="Collapsed"><ScrollViewer><StackPanel x:Name="HistoryList"/></ScrollViewer></Grid>
      <Grid Grid.Row="1" x:Name="SourcesPage" Visibility="Collapsed">
        <ScrollViewer><StackPanel>
          <Border Background="#151D2B" BorderBrush="#2B354A" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,20"><StackPanel>
            <TextBlock Text="Add a GitHub patch source" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Paste a public repository or release link. Add sources you trust: newer patch packs from these repositories will replace their saved definitions." Foreground="#A3AEC2" TextWrapping="Wrap" LineHeight="21" FontSize="13" Margin="0,12,0,14"/>
            <TextBlock Text="GITHUB LINK" Foreground="#73819A" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SourceLinkBox" ToolTip="https://github.com/owner/patches" FontSize="13" Margin="0,0,12,0"/><Button x:Name="AddSourceButton" Grid.Column="1" Content="Add source" Style="{StaticResource PrimaryButton}"/></Grid>
            <CheckBox x:Name="SourcePrereleases" Content="Include pre-release patch packs (experimental)" IsChecked="True" FontSize="12" Margin="0,16,0,14"/>
            <TextBlock Text="Automatic checks run when Patchwork opens and about once an hour while it is open. They update your library. Preview and apply to update an already-patched app from its verified original backups." Foreground="#929DB1" TextWrapping="Wrap" FontSize="12" LineHeight="20"/>
          </StackPanel></Border>
          <WrapPanel Margin="0,0,0,16"><Button x:Name="CheckSourcesButton" Content="Check all sources" FontSize="12" Margin="0,0,15,6"/><TextBlock x:Name="SourcesStatus" Text="Published JSON or .patchwork release assets · No GitHub sign-in needed" Foreground="#929DB1" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"/></WrapPanel>
          <StackPanel x:Name="SourcesList"/>
        </StackPanel></ScrollViewer>
      </Grid>
      <Grid Grid.Row="1" x:Name="AboutPage" Visibility="Collapsed">
        <ScrollViewer x:Name="AboutScroll"><StackPanel>
          <Border Background="#151D2B" BorderBrush="#2B354A" BorderThickness="1" CornerRadius="12" Padding="26" Margin="0,0,0,18"><StackPanel>
            <TextBlock Text="Windows patches, kept local." FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Patchwork is a native Windows patch manager. This build supports separate patch files, managed assembly edits, method previews, verified backups, and restoration." TextWrapping="Wrap" Foreground="#A3AEC2" Margin="0,13,0,0" LineHeight="23"/>
            <TextBlock Text="Ready today" Foreground="#85DCC0" FontWeight="SemiBold" Margin="0,24,0,10"/>
            <TextBlock Text="• Local JSON, text, and managed assembly patches with SHA-256 checks&#10;• Multiple patches, dependency checks, and conflict detection&#10;• Transaction history, rollback, and interrupted-transaction recovery&#10;• GitHub patch sources with automatic pack updates&#10;• Update applied patches using verified originals; no manual restore&#10;• Separate patch packs; no bundled definitions" Foreground="#A3AEC2" LineHeight="25" TextWrapping="Wrap"/>
            <TextBlock Text="Patch files live separately" Foreground="#E9C985" FontWeight="SemiBold" Margin="0,24,0,10"/>
            <TextBlock Text="The installer contains the patcher and guides. Add patch files from their separate repository or another source you trust. Updating the patcher preserves imported files and history." Foreground="#A3AEC2" TextWrapping="Wrap" LineHeight="23"/>
          </StackPanel></Border>
          <Border Background="#121A27" BorderBrush="#2B354A" BorderThickness="1" CornerRadius="12" Padding="24"><StackPanel>
            <TextBlock Text="Installed, inspectable, local." FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Patchwork uses no account or telemetry. Patching stays local; update checks contact GitHub. Local imports contain data-only recipes. Backups and history live separately in your local application data, so uninstalling or updating Patchwork preserves them." Foreground="#A3AEC2" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,17"/>
            <StackPanel Orientation="Horizontal"><Button x:Name="OpenDataButton" Content="Open data folder" Margin="0,0,10,0"/><Button x:Name="OpenDocsButton" Content="Read the guide"/></StackPanel>
          </StackPanel></Border>
          <Border Background="#151D2B" BorderBrush="#2B354A" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,18,0,0"><StackPanel>
            <TextBlock Text="App updates" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="UpdateVersion" Foreground="#A3AEC2" FontSize="12" Margin="0,10,0,0"/>
            <TextBlock x:Name="UpdateStatus" Text="Check GitHub for the latest patcher release." Foreground="#929DB1" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,14"/>
            <CheckBox x:Name="AutoUpdateCheck" Content="Check for app updates when Patchwork opens" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check for updates" Margin="0,0,10,8"/><Button x:Name="InstallUpdateButton" Content="Download and install" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="0,0,10,8"/><Button x:Name="ReleasesButton" Content="View GitHub releases" Margin="0,0,0,8"/></WrapPanel>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#253047" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,17,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready. Add a separate patch file to get started." Foreground="#8E9BB3" FontSize="11" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="LOCAL PATCHING" Foreground="#56657E" FontSize="9" FontWeight="Bold" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
